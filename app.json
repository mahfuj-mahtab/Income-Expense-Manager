{
  "expo": {
    "name": "Money Plan",
    "slug": "expense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/money-plan-mark.png",
    "scheme": "expense",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expense"
    },
    "android": {
      "package": "com.expense",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/money-plan-mark.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/money-plan-splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#071E33",
          "dark": {
            "backgroundColor": "#071E33"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60be0fbe-cc94-4385-bdf6-9e7fed179545"
      }
    }
  }
}
